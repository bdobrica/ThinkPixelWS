{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.thinkpixel.io/schemas/v1alpha1/workspace-manifest.json",
  "title": "ThinkPixelWS Workspace Manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "components"],
  "properties": {
    "apiVersion": {"const": "workspace.thinkpixel.io/v1alpha1"},
    "kind": {"const": "Workspace"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "components": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/component"}},
    "externalBindings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/externalBinding"}},
    "applicationProfiles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/profileBinding"}},
    "environment": {"$ref": "#/$defs/environmentBinding"},
    "classification": {"$ref": "#/$defs/classification"},
    "residency": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "uri": {"type": "string", "minLength": 1, "maxLength": 2048, "format": "uri"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "labels": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 256}}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/uri"}, "sourceType": {"type": "string", "maxLength": 64}, "sourceRevision": {"type": "string", "maxLength": 512},
        "importedAt": {"type": "string", "format": "date-time"}, "initiatingPrincipal": {"type": "string", "maxLength": 256}, "sourceRunId": {"type": "string", "format": "uuid"},
        "derivedFrom": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/digest"}}, "classification": {"$ref": "#/$defs/classification"},
        "sourceTrust": {"enum": ["trusted-internal", "authenticated-external", "external-untrusted"]}, "taints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["ref", "mode"],
      "properties": {"ref": {"$ref": "#/$defs/uri"}, "mode": {"enum": ["snapshot", "refreshable-snapshot", "live-reference"]}, "revision": {"type": "string", "maxLength": 512}}
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "path"],
      "properties": {
        "name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["repository", "directory", "document-collection", "artifact-collection"]},
        "path": {"type": "string", "pattern": "^/workspace/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"}, "source": {"$ref": "#/$defs/source"},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["ref", "digest", "mediaType"], "properties": {"ref": {"$ref": "#/$defs/uri"}, "digest": {"$ref": "#/$defs/digest"}, "mediaType": {"type": "string", "maxLength": 255}, "size": {"type": "integer", "minimum": 0}}},
        "provenance": {"$ref": "#/$defs/provenance"}, "classification": {"$ref": "#/$defs/classification"}, "taints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "externalBinding": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "ref", "mode"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["collaboration", "issue-tracker", "document-store", "database", "service", "observability"]}, "ref": {"$ref": "#/$defs/uri"}, "mode": {"enum": ["live-reference", "materialized-copy"]}, "classification": {"$ref": "#/$defs/classification"}}
    },
    "profileBinding": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "ref"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["browser", "desktop", "application", "ide"]}, "ref": {"$ref": "#/$defs/uri"}, "retentionPolicy": {"type": "string", "maxLength": 128}}
    },
    "environmentBinding": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
      "properties": {"kind": {"enum": ["oci", "thinkpixelmp", "devcontainer", "devfile", "runtime-profile"]}, "ref": {"$ref": "#/$defs/uri"}, "digest": {"$ref": "#/$defs/digest"}, "platform": {"type": "string", "maxLength": 128}}
    }
  }
}
